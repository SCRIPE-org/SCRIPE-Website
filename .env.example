# Public site origin, used for canonicals/OG/sitemap. No trailing slash.
SITE_URL=https://www.scripe.org
# Allows search engines to index the site (see src/app/robots.ts). On
# Vercel, production deploys are already detected automatically via
# VERCEL_ENV and this is not needed. Set to "true" on any OTHER production
# host (self-hosted, another PaaS) so that host isn't stuck disallow-all
# forever with no way to opt in. Leave unset everywhere else (previews,
# local dev, CI) — indexing defaults closed.
SITE_INDEXABLE=
# SCRIPE backend API base (public endpoints only). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api.scripe.org/api
# The SCRIPE app's sign-in destination (header/mobile-nav "Sign In" CTA).
# Public by design (ships to the browser). No trailing slash.
NEXT_PUBLIC_APP_URL=https://admin.scripe.org
# Contact form lead-intake endpoint (server-only — deliberately NOT
# NEXT_PUBLIC_*, never bundled to the client). Optional: unset until set, in
# which case the contact form still validates every submission and honestly
# reports "not connected" instead of a fabricated success.
#
# The real backend already has exactly one route built for this — the same
# one the product app's own signup wizard calls for its "Contact Sales"
# step (POST .../v1/auth/signup/contact-sales, SelfServiceSignupController
# in SCRIPE-Backend) — so the recommended production value is:
#   LEADS_ENDPOINT=https://api.scripe.org/api/v1/auth/signup/contact-sales
# MUST be the api.scripe.org (Cloudflare-fronted) host, never the raw Render
# origin directly — see src/lib/leads/submit-lead.ts's own comment at the
# LEADS_ENDPOINT read site for why the raw origin gets a flat 403 no matter
# how correct everything else is.
LEADS_ENDPOINT=
