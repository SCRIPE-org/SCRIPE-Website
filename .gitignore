# Dependencies
node_modules/

# Next.js build output
.next/
# next dev's own output directory (see next.config.ts's distDir) — kept
# fully separate from the production build's .next/ so a stray dev server
# can never corrupt a build's manifests via a shared cache.
.next-dev/

# Auto-generated by Next.js/TypeScript at dev/build/typecheck time
next-env.d.ts
*.tsbuildinfo

# Environment variables
.env*
!.env.example

# Scratch workspace
.superpowers/

# Next.js auto-generates these agent instruction files on every `next dev` run
# (node_modules/next/dist/server/lib/generate-agent-files.js). The project keeps its
# own guidance in docs/ and the parent monorepo; ignore the generated stubs.
/AGENTS.md
/CLAUDE.md
