      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:none|fwd|up)$/]",
        "message": "<TextLink> arrow must be one of 'none' | 'fwd' | 'up'."
