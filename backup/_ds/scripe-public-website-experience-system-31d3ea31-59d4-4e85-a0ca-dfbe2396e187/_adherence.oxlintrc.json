        "selector": "JSXOpeningElement[name.name='StatMetric'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|sub|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatMetric> doesn't accept that prop. Declared props: value, label, sub, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatMetric'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|academy|venue|club|football|live)$/]",
        "message": "<StatMetric> tone must be one of 'default' | 'academy' | 'venue' | 'club' | 'football' | 'live'."
