      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:link|primary|inverse)$/]",
        "message": "<TextLink> tone must be one of 'link' | 'primary' | 'inverse'."
