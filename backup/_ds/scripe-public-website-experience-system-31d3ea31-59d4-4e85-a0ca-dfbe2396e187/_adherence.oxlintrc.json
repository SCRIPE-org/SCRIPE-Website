{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/conversion/**",
              "components/evidence/**",
              "components/footer/**",
              "components/navigation/**",
              "components/storytelling/**",
              "guidelines/proof/**",
              "ui_kits/public_site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Inter|Noto Sans Arabic|Noto Kufi Arabic))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Inter, Noto Sans Arabic, Noto Kufi Arabic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|arrow|href|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, arrow, href, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onMedia)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onMedia'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:t|variant|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<DemoForm> doesn't accept that prop. Declared props: t, variant, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoForm'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:demo|trial)$/]",
        "message": "<DemoForm> variant must be one of 'demo' | 'trial'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|tone|line|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: index, tone, line, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|brand|academy|venue|club|football|live)$/]",
        "message": "<Eyebrow> tone must be one of 'default' | 'accent' | 'brand' | 'academy' | 'venue' | 'club' | 'football' | 'live'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormationPitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:formation|interactive|trial|label|trialLabel|legend|onFormationChange|style|key|ref|className|style|children)$/]",
        "message": "<FormationPitch> doesn't accept that prop. Declared props: formation, interactive, trial, label, trialLabel, legend, onFormationChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormationPitch'] > JSXAttribute[name.name='formation'] > Literal[value!=/^(?:5v5|7v7|9v9|11v11)$/]",
        "message": "<FormationPitch> formation must be one of '5v5' | '7v7' | '9v9' | '11v11'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocaleOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|short|label|dir|flag|key|ref|className|style|children)$/]",
        "message": "<LocaleOption> doesn't accept that prop. Declared props: code, short, label, dir, flag."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocaleOption'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:ltr|rtl)$/]",
        "message": "<LocaleOption> dir must be one of 'ltr' | 'rtl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:ratio|src|alt|label|meta|scrim|reveal|radius|height|grade|children|style|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: ratio, src, alt, label, meta, scrim, reveal, radius, height, grade, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='grade'] > Literal[value!=/^(?:dusk|turf|aqua|court)$/]",
        "message": "<MediaFrame> grade must be one of 'dusk' | 'turf' | 'aqua' | 'court'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MegaMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|name|desc|color|href|key|ref|className|style|children)$/]",
        "message": "<MegaMenuItem> doesn't accept that prop. Declared props: key, name, desc, color, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBarLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|mega|href|key|ref|className|style|children)$/]",
        "message": "<NavBarLink> doesn't accept that prop. Declared props: key, label, mega, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|product|blurb|priceNote|priceMeta|includes|ctaLabel|onCta|featured|badge|footnote|style|key|ref|className|style|children)$/]",
        "message": "<PricingTier> doesn't accept that prop. Declared props: name, product, blurb, priceNote, priceMeta, includes, ctaLabel, onCta, featured, badge, footnote, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute[name.name='product'] > Literal[value!=/^(?:academy|venue|club|football)$/]",
        "message": "<PricingTier> product must be one of 'academy' | 'venue' | 'club' | 'football'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:product|label|desc|showDesc|size|style|key|ref|className|style|children)$/]",
        "message": "<ProductChip> doesn't accept that prop. Declared props: product, label, desc, showDesc, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductChip'] > JSXAttribute[name.name='product'] > Literal[value!=/^(?:academy|venue|club|football)$/]",
        "message": "<ProductChip> product must be one of 'academy' | 'venue' | 'club' | 'football'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<ProductChip> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|role|org|tone|sample|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<QuoteBlock> doesn't accept that prop. Declared props: quote, role, org, tone, sample, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|academy|venue|club|football)$/]",
        "message": "<QuoteBlock> tone must be one of 'default' | 'academy' | 'venue' | 'club' | 'football'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|index|tone|title|lede|size|align|maxWidth|level|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, index, tone, title, lede, size, align, maxWidth, level, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|brand|academy|venue|club|football)$/]",
        "message": "<SectionHeading> tone must be one of 'default' | 'accent' | 'brand' | 'academy' | 'venue' | 'club' | 'football'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:cinema|hero|lg|md|h1)$/]",
        "message": "<SectionHeading> size must be one of 'cinema' | 'hero' | 'lg' | 'md' | 'h1'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<SectionHeading> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|id|options|placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SelectField> doesn't accept that prop. Declared props: label, hint, error, required, id, options, placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|dot|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href, key, dot."
      },
