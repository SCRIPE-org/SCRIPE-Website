        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, multiline, required, id, placeholder, type, value, onChange, inputStyle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|arrow|tone|size|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, arrow, tone, size, onClick, children, style."
